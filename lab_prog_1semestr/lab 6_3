#include <math.h>
#include <stdio.h>
#include <stdlib.h>
// 3.	Сформировать с помощью датчика случайных чисел в диапазоне [0,10] массив
// из 20 элементов вещественного типа. Вывести его на экран. Вывести элементы
//массива, большие своих соседей справа и слева.

const int N = 20;
int main() {
  float k[21], n;
  for (int i = 0; i < N; i++) {
    k[i] = (float)rand() * 10 / RAND_MAX;
    printf(" %.1f ", k[i]);
  }
  printf("\n");

  for (int i = 1; i < n; i++) {
    if ((k[i] > k[i - 1] && k[i] > k[i + 1])) printf(" %.1f ", k[i]);
  }
  system("PAUSE");
  return 0;
}