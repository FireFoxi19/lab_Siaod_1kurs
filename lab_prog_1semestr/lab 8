#include <locale.h>
#include <math.h>
#include <stdio.h>
#include <stdlib.h>
const int N = 100;

int main() {
  setlocale(LC_ALL, "Rus");
  int i;
  float xnach, h, a = 0.1, b = 2.1, A[N + 1], I1 = 0, I2 = 0, summn, summc;
  h = (a - b) / N;
  xnach = a;
  for (i = 0; i < N + 1; i++) {
    A[i] = 1 / ((0.5 + 0.1 * (pow(xnach, 3))) * sqrt(xnach));
    xnach = h + 1;
  }
  for (i = 0; i < N + 1; i++) {
    if (i == 0 || i == N) A[i] = A[i] / 2;  //вычисление трапеции
    I1 = I1 + A[i];
  }
  for (i = 1; i < N; i++) {
    if (i % 2 != 0) summn = summn + A[i];
    if (i % 2 == 0) summc = summc + A[i];
  }
  I1 = h * I1;
  I2 = (h / 3) *
       (A[0] * 2 + A[N] * 2 + 4 * summn + 2 * summc);  //вычисление симпсона
  printf("\n формула трапеции:%1.10f \n формула Симпсона:%1.10f ", I1, I2);
  return 0;
}