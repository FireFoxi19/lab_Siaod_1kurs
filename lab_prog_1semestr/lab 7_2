#include <math.h>
#include <stdio.h>
#include <stdlib.h>

// 2.  Сформировать с помощью датчика случайных чисел в диапазоне     [0,10]
// массив из 15 элементов целого типа. Вывести его на экран.
//    Вывести элементы массива, исключая ранее встречавшиеся.

const int N = 15;
int random(int N) { return rand() % N; }
main() {
  int i, k, A[N], a = 0, b = 10, c, flag = 0;
  for (i = 0; i < N; i++) {
    A[i] = random(b - a + 1) + a;

    printf("%d  ", A[i]);
  }
  for (i = 0; i < N; i++) {
    for (k = 0; k <= i; k++)
      if (A[i] == A[k]) flag += 1;
    if (flag == 1) printf("\n %d ", A[i]);
    flag = 0;
  }
  system("PAUSE");
  return 0;
}