#include <math.h>
#include <stdio.h>
// 4.	Написать программу для проверки номера банковской карты по алгоритму
// Луна (необходимо просуммировать все четные по номеру цифры последовательности,
//далее прибавить к сумме все нечетные по номеру цифры, помноженные на 2, при
//этом если произведение получается больше 9, то из него вычитается 9. Сумма
//должна быть кратной 10). Пример правильного номера - 4276 4400 1336 1511

int main() {
  int card[16];
  int sum = 0;
  int p = 0;
  int i = 0;
  for (int i = 0; i < 16; i++) scanf("%d", &card[i]);
  for (int i = 0; i < 16; i++) {
    p = card[i];
    if (i % 2 == 0) {
      p = p * 2;
      if (p > 9) p = p - 9;
    }
    sum = sum + p;
  }
  if (sum % 10 == 0)
    printf("return the number %d", sum);
  else
    printf("Don't return the number %d", sum);
  return 0;
}