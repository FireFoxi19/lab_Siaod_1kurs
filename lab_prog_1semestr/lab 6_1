#include <math.h>
#include <stdio.h>
#include <stdlib.h>
#include <iostream>
// 1. Сформировать с помощью датчика случайных чисел в диапазоне [-10,10] массив
// из 20 элементов целого типа. Вывести его на экран.  Затем вывести на экран
// все
//положительные элементы массива, и все отрицательные элементы.
int random(int N) { return rand() % N; }

int main(int argc, char *argv[]) {
  const int N = 21;

  {
    system("CLS");

    int i, A[N], a = -10, b = 10;

    for (i = 0; i < N; i++) A[i] = random(b - a + 1) + a;

    for (i = 0; i < N; i++) printf("%4d", A[i]);

    for (i = 0; i < N; i++)

      if (A[i] < 0) printf("\n%4d<0", A[i]);

    for (i = 0; i < N; i++)

      if (A[i] > 0) printf("\n%4d>0", A[i]);

    system("PAUSE");

    return 0;
  }
  return 0;
}