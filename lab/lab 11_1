#include <stdlib.h>
#include <time.h>
#include <iostream>

using namespace std;

struct List {
  int num;
  List *next;
};

void Print(List *b) {
  List *print = b;
  while (print) {
    cout << print->num << " ";
    print = print->next;
  }
  cout << "Null" << endl;
}

void Rand(int n, List **begin) {
  srand(time(NULL));
  List *k;
  for (int i = 0; i < n; i++) {
    k = new List;
    k->num = rand() % n;
    k->next = *begin;
    *begin = k;
  }
}
void Inc(int n, List **begin) {
  List *k;
  for (int i = n; i > 0; i--) {
    k = new List;
    k->num = i;
    k->next = *begin;
    *begin = k;
  }
}

void Dec(int n, List **begin) {
  List *k;
  for (int i = 1; i <= n; i++) {
    k = new List;
    k->num = i;
    k->next = *begin;
    *begin = k;
  }
}

int CheckSum(List *begin) {
  int sum = 0;
  List *k = begin;
  while (k) {
    sum += k->num;
    k = k->next;
  }
  return sum;
}

int RunNumber(List *begin) {
  int i = 1;
  List *k = begin;
  while (k->next) {
    if (k->num > k->next->num) {
      i++;
    }
    k = k->next;
  }
  return i;
}

int main() {
  srand(time(NULL));
  List *begin1 = NULL, *begin2 = NULL, *begin3 = NULL;
  int n;
  cout << "Enter size Lists: " << endl;
  cin >> n;

  cout << "FillInc:" << endl;
  Inc(n, &begin1);
  Print(&*begin1);
  cout << "IncSum: " << CheckSum(&*begin1) << endl;
  cout << "IncRunNumber: " << RunNumber(&*begin1) << endl;

  cout << endl << "FillDec:" << endl;
  Dec(n, &begin2);
  Print(&*begin2);
  cout << "DecSum: " << CheckSum(&*begin2) << endl;
  cout << "DecRunNumber: " << RunNumber(&*begin2) << endl;

  cout << endl << "FillRand:" << endl;
  Rand(n, &begin3);
  Print(&*begin3);
  cout << "RandSum: " << CheckSum(&*begin3) << endl;
  cout << "RandRunNumber: " << RunNumber(&*begin3) << endl;

  return 0;
}
