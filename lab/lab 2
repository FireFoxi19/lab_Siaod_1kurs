int rand(int N) { return rand() % N; }

void FillInc(int A[], int n) {
  for (int i = 0; i <= n - 1; i++) A[i] = i;
}

void FillDec(int A[], int n) {
  int i = 0, j = 0;
  for (i = n - 1, j = 0; i >= 0, j <= n - 1; i--, j++) A[j] = i;
}

void FillRand(int A[], int n) {
  int i = 0, a = 1, b = 20;
  for (i = 0; i <= n - 1; i++) A[i] = rand() * (b - a) / RAND_MAX + a;
}

