using namespace std;
int C = 0;

void ShellSort(int mas[], int n) {
  int m = trunc(log2(n)) - 1;
  int h[m + 1];
  h[1] = 1;
  for (int i = 2; i < m + 1; i++) {
    h[i] = 2 * h[i - 1] + 1;
  }
  for (; h[m] > 0; m--) {
    int k = h[m];
    for (int i = k; i <= n; i++) {
      int t = mas[i];
      int j = i - k;
      while ((j >= 0) && (t < mas[j])) {
        mas[j + k] = mas[j];
        j = j - k;
      }
      mas[j + k] = t;
    }
  }
}

void fill_array(int mas[], int n) {
  for (int i = 0; i < n; i++) mas[i] = rand() % 10;
}

void print_array(int mas[], int n) {
  for (int i = 0; i < n; i++) cout << mas[i] << " ";
  cout << endl;
}

bool BSearch1(int mas[], int n, int key) {
  C = 0;
  int l = 0;
  int r = n;
  while (l <= r) {
    C++;
    int m = floor((l + r) / 2);
    if (mas[m] == key) return true;
    C++;
    if (mas[m] < key)
      l = m + 1;
    else
      r = m - 1;
  }
  return false;
}

bool BSearch2(int mas[], int n, int key) {
  C = 0;
  int l = 0;
  int r = n;
  while (l < r) {
    int m = floor((l + r) / 2);
    C++;
    if (mas[m] < key)
      l = m + 1;
    else
      r = m;
  }
  C++;
  return (mas[r] == key);
}

int main() {
  int key = 7;
  cout << "n BSearch1   BSearch2" << endl;
  for (int i = 100; i <= 1000; i += 100) {
    int* a = new int[i];
    fill_array(a, i);
    ShellSort(a, i);
    BSearch1(a, i, key);
    int CM1 = C;
    BSearch2(a, i, key);
    int CM2 = C;
    cout << i << "   " << CM1 << "          " << CM2 << endl;
  }

  cout << endl << endl << endl;

  cout << " BSearch1    BSearch2" << endl;
  cout << "n first mid none last first mid last none" << endl;
  for (int i = 100; i <= 1000; i += 100) {
    int* a = new int[i];
