    ShellSort(a, i);
    BSearch1(a, i, a[0]);
    int CM_1_first = C;
    BSearch1(a, i, a[i / 2]);
    int CM_1_mid = C;
    BSearch1(a, i, a[i - 1]);
    int CM_1_last = C;
    BSearch1(a, i, -1);
    int CM_1_none = C;

    BSearch2(a, i, a[0]);
    int CM_2_first = C;
    BSearch2(a, i, a[i / 2]);
    int CM_2_mid = C;
    BSearch2(a, i, a[i - 1]);
    int CM_2_last = C;
    BSearch2(a, i, -1);
    int CM_2_none = C;

    printf("%3d %3d %3d %3d %3d %3d %3d %3d %3d\n", i, CM_1_first, CM_1_mid,
           CM_1_last, CM_1_none, CM_2_first, CM_2_mid, CM_2_last, CM_2_none);
  }
}