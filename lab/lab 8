  cout << endl << endl << endl;

  cout << "NAME     SECOND NAME  PHONE NUMBER   ADRESS" << endl;
  int* new_order2 = sort_by_second_name(ar, n);  //Отсортирован по фамилии
  for (int i = 0; i < n; i++) print_data(ar[new_order2[i]]);
  cout << endl << endl << endl;

