int C = 0, M = 0;
int random(int n) { return rand() % n; }

void Fillinc(int A[], int n)  // возрастающая сортировка
{
  for (int i = 0; i < n; i++) A[i] += i;
}

void FillDec(int A[], int n)  // убывающая сортировка
{
  for (int i = 0; n > 0; i++, n--) A[i] = n - 1;
}

void PrintMas(int A[], int n) {
  for (int i = 0; i < n; i++) printf("%d; ", A[i]);
}

void FillRand(int A[], int n) {
  for (int i = 0; i < n; i++) A[i] = random(b - a + 1) + a;
}

int CheckSum(int A[], int n) {
  int sum = 0;
  for (int i = 0; i < n; i++) sum = sum + A[i];

  return sum;
}

int RunNumber(int A[], int n)  // случайная сортировка
{
  int k = 0;
  for (int i = 0; i < n; i++) {
    if (A[i] > A[i + 1]) k += 1;
  }
  return k;
}

void Puzirek(int A[], int n) {
  int buf = 0;
  for (int i = 1; i < n - 1; i++) {
    for (int j = (n - 1); j > i; j--) {
      C++;  // кол-во сравнений
      if (A[j - 1] > A[j]) {
        buf = A[j - 1];
        A[j - 1] = A[j];
        A[j] = buf;
        M++;  // кол-во пересылок
      }
    }
  }
}

void BubbleSort(int A[], int n) {
  M = 0;
  C = 0;
  for (int i = 0; i < n - 1; i++) {
    for (int j = n - 1; j > i; j--) {
      C++;
      if (A[j] < A[j - 1]) {
        int t = A[j];
        A[j] = A[j - 1];
        A[j - 1] = t;
        M += 3;
      }
    }
  }
}

