#include <stdlib.h>
#include <time.h>
#include <iostream>
using namespace std;

class LinkedList {
 public:
  LinkedList() { head = NULL; }

  void generate_rand(int n);
  void generate_inc(int n);
  void generate_dec(int n);
  void print();
  int control_sum();
  int run_number();
  void clear();

 private:
  struct Data {
    int num;
    Data *next = NULL;
  };
  Data *head;
  void print_node(Data *tmp);
};

void LinkedList::generate_rand(int n) {
  if (n <= 0) return;
  if (!head) clear();
  head = new Data;
  Data *tmp2 = head;
  int i = 0;
  while (i < n) {
    Data *tmp = new Data;
    tmp->num = rand() % 100;
    tmp2->next = tmp;
    tmp2 = tmp;
    i++;
  }
  tmp2->next = NULL;
}

void LinkedList::generate_dec(int n) {
  if (n <= 0) return;
  if (!head) clear();
  head = new Data;
  Data *tmp2 = head;
  int i = 0;
  while (i < n) {
    Data *tmp = new Data;
    tmp->num = n - i;
    tmp2->next = tmp;
    tmp2 = tmp;
    i++;
  }
  tmp2->next = NULL;
}

void LinkedList::generate_inc(int n) {
  if (n <= 0) return;
  if (!head) clear();
  head = new Data;
  Data *tmp2 = head;
  int i = 0;
  while (i < n) {
    Data *tmp = new Data;
    tmp->num = i + 1;
    tmp2->next = tmp;
    tmp2 = tmp;
    i++;
  }
  tmp2->next = NULL;
}

void LinkedList::print_node(Data *tmp) { cout << tmp->num << " "; }

void LinkedList::print() {
  if (head == NULL) return;
  if (head->next != NULL) {
    Data *tmp = head->next;
    while (tmp != NULL) {
      print_node(tmp);
      tmp = tmp->next;
    }
    cout << endl;
  }
}

int LinkedList::control_sum() {
  if (head == NULL) return 0;
  int sum = 0;
  if (head->next != NULL) {
    Data *tmp = head->next;
    while (tmp != NULL) {
      sum += tmp->num;
      tmp = tmp->next;
    }
  }
  return sum;
}

int LinkedList::run_number() {
  if (head == NULL) return 0;
  int k = 1;
  if (head->next != NULL) {
    Data *tmp = head->next;
    while (tmp->next != NULL) {
      if (tmp->num >= tmp->next->num) k++;
      tmp = tmp->next;
    }
  }
  return k;
}

void LinkedList::clear() {
  Data *tmp = head;
  Data *next;
  while (tmp != NULL) {
    next = tmp->next;
    delete tmp;
    tmp = next;
  }
  head = NULL;
}

int main() {
  int n = 5;

  LinkedList *list = new LinkedList;
  srand(time(NULL));

  list->generate_rand(n);
  list->print();
  cout << "Control Sum = " << list->control_sum() << endl;
  cout << "Run number = " << list->run_number() << endl << endl;

  list->generate_inc(n);
  list->print();
  cout << "Control Sum = " << list->control_sum() << endl;
  cout << "Run number = " << list->run_number() << endl << endl;

  list->generate_dec(n);
  list->print();
  cout << "Control Sum = " << list->control_sum() << endl;
  cout << "Run number = " << list->run_number() << endl << endl;

  list->clear();
  delete list;
  list = NULL;
}
