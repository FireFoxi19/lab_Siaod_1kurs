#include <stdio.h>
#include <stdlib.h>

int C = 0, M = 0;

void FillRand(int *A, int n) {
  for (int i = 0; i < n; i++) A[i] = rand() % n;
}

void FillInc(int *A, int n) {
  for (int i = 0; i < n; i++) A[i] = i;
}

void FillDec(int *A, int n) {
  for (int i = 0; i < n; i++) {
    int j = n - i;
    A[i] = j;
  }
}

int BubbleSort(int *A, int n) {
  M = 0;
  C = 0;
  int i, j, temp;
  for (i = 0; i < n - 1; i++) {
    for (j = n - 1; j > i; j--) {
      if (A[j - 1] > A[j]) {
        temp = A[j - 1];
        A[j - 1] = A[j];
        A[j] = temp;
        M += 3;
      }
      C++;
    }
  }
  return (C + M);
}

int ShakerSort(int *A, int n) {
  M = 0;
  C = 0;
  int i, j, temp, L = 0, R = n - 1,
                  k = n - 1;  // границы рабочей части и кол-во элементов
  do {
    for (i = R; i > L; i--) {
      if (A[i - 1] > A[i]) {
        temp = A[i - 1];  // обмен
        A[i - 1] = A[i];
        A[i] = temp;
        k = i;
        M += 3;
      }
      C++;
    }
    L = k;
    for (j = L; j < R; j++) {
      if (A[j] > A[j + 1]) {
        temp = A[j + 1];
        A[j + 1] = A[j];
        A[j] = temp;
        k = j;
        M += 3;  //пересылки
      }
      C++;  // сравнения
    }
    R = k;
  } while (L < R);
  return (C + M);
}

int main() {
  int n = 500;
  int A[n];
  n = 10;
  int Yb[n], Sb[n], Vb[n], Ys[n], Ss[n], Vs[n];

  for (int i = 0; i < 5; i++) {
    n = (i + 1) * 100;
    FillDec(A, n);
    Yb[i] = BubbleSort(A, n);
    FillDec(A, n);
    Ys[i] = ShakerSort(A, n);

    FillRand(A, n);
    Sb[i] = BubbleSort(A, n);
    FillRand(A, n);
    Ss[i] = ShakerSort(A, n);

    FillInc(A, n);
    Vb[i] = BubbleSort(A, n);
    FillInc(A, n);
    Vs[i] = ShakerSort(A, n);
  }
  printf(" _____ ________________________ ________________________ \n");
  printf("|  n  |       M+C Bubble       |        M+C Shaker      |\n");
  printf("|_____|________________________|________________________|\n");
  printf("|     |  dec  |  rand  |  inc  |  dec  |  rand  |  inc  |\n");
  printf("|_____|________________________|________________________|\n");
  for (int i = 0; i < 5; i++) {
    printf("| %d | %d | %d | %d | %d |  %d | %d \n", (i + 1) * 100, Yb[i],
           Sb[i], Vb[i], Ys[i], Ss[i], Vs[i]);
    printf("|______________________________________________________|\n");
  }

  return 0;
}