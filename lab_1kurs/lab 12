#include <cmath>
#include <ctime>
#include <iostream>

using namespace std;

int C = 0;
int M = 0;

struct List {
  List *next = nullptr;  // константа нулевого указателя
  int data;
};

struct Queue {
  List *head;
  List *tail;
};

void print_list(List *head) {
  List *p = head;
  while (p) {
    cout << p->data << " ";
    p = p->next;
  }
  cout << endl;
}

List *fill_inc(int n) {
  List *p = nullptr, *head = nullptr;
  for (int i = n - 1; i >= 0; i--) {
    p = new List;
    p->data = i;
    p->next = head;
    head = p;
  }
  return head;
}

List *fill_dec(int n) {
  List *p = nullptr, *head = nullptr;
  for (int i = 0; i < n; i++) {
    p = new List;
    p->data = i;
    p->next = head;
    head = p;
  }
  return head;
}

List *fill_rand(int n) {
  List *p = nullptr, *head = nullptr;
  srand(time(nullptr));
  for (int i = 0; i < n; i++) {
    p = new List;
    p->data = rand() % (2 * n);
    p->next = head;
    head = p;
  }
  return head;
}

int check_sum(List *head) {
  int sum = 0;
  List *p = head;
  while (p) {
    sum += p->data;
    p = p->next;
  }
  return sum;
}

int run_number(List *head) {
  int i = 1;
  List *p = head;
  while (p->next) {
    if (p->data > p->next->data) {
      i += 1;
    }
    p = p->next;
  }
  return i;
}

void clear(List *&head) {
  if (head == nullptr) return;
  List *p = head, *temp;
  while (p) {
    temp = p;
    p = p->next;
    delete temp;
  }
  head = nullptr;
}

void split(List *head, List *&a, List *&b, int &n) {
  List *k, *p;
  a = head, b = head->next;
  n = 1;
  k = a;
  p = b;
  while (p) {
    n++;
    k->next = p->next;
    k = p;
    p = p->next;
  }
}

void merge(List *&a, int q, List *&b, int r, Queue &c) {
  while (q != 0 && r != 0) {
    C++;
    if (a->data <= b->data) {
      c.tail->next = a;
      c.tail = a;
      a = a->next;
      M++;
      q--;
    } else {
      c.tail->next = b;
      c.tail = b;
      b = b->next;
      M++;
      r--;
    }
  }
  while (q > 0) {
    c.tail->next = a;
    c.tail = a;
    a = a->next;
    M++;
    q--;
  }
  while (r > 0) {
    c.tail->next = b;
    c.tail = b;
    b = b->next;
    M++;
    r--;
  }
}

int get_size(List *head) {
  int size = 0;
  List *p = head;
  while (p) {
    size++;
    p = p->next;
  }
  return size;
}

void merge_sort(List *&head) {
  M = 0;
  C = 0;
  int n = 0;
  List *a = NULL, *b = NULL, *head_p = head;
  int p, i, m, q, r;
  split(head_p, a, b, n);
  M += n;
  Queue c[2];
  p = 1;
  c[0].tail = (List *)&c[0].head;
  while (p < n) {
    c[0].tail = (List *)&c[0].head;
    c[1].tail = (List *)&c[1].head;
    i = 0, m = n;
    while (m > 0) {
      if (m >= p)
        q = p;
      else
        q = m;
      m -= q;
      if (m >= p)
        r = p;
      else
        r = m;
      m -= r;
      merge(a, q, b, r, c[i]);
      i = 1 - i;
    }
    a = c[0].head, b = c[1].head;
    p *= 2;
  }
  c[0].tail->next = NULL;
  head = c[0].head;
}

int main() {
  cout << " _____________________________________________________" << endl;
  cout << "|    n    |               fact           |    theor   |" << endl;
  cout << "|_________|______________________________|____________|" << endl;
  cout << "|         |   inc   |   dec   |   rand   |            |" << endl;
  cout << "|_________|_________|_________|__________|____________|" << endl;
  for (int n = 100; n <= 500; n += 100) {
    List *list = fill_inc(n);
    merge_sort(list);
    int CM_inc = C + M;
    clear(list);

    list = fill_dec(n);
    merge_sort(list);
    int CM_dec = C + M;
    clear(list);

    list = fill_rand(n);
    merge_sort(list);
    int CM_rand = C + M;
    clear(list);

    cout << "|   " << n << "   |   " << CM_inc << "  |   " << CM_dec
         << "  |    " << CM_rand << "  |     " << 2 * n * ceil(log2(n)) + n
         << "   |" << endl;
  }
  cout << "|_____________________________________________________|" << endl;
  return 0;
}
