#include <stdio.h>
#include <stdlib.h>
#include <iostream>

int C = 0, M = 0;

void FillInc(int *A, int n) {
  for (int i = 0; i < n; i++) A[i] = i;
}

void FillDec(int *A, int n) {
  for (int i = 0; i < n; i++) {
    int j = n - i;
    A[i] = j;
  }
}

void FillRand(int *A, int n) {
  for (int i = 0; i < n; i++) A[i] = rand() % n;
}

int InsertSort(int *A, int n) {
  M = 0;
  C = 0;
  for (int i = 1; i < n; i++) {
    int j = i;
    int min = A[i];  // запоминаем значение элемента
    C++;
    while (
        (j > 0) &&
        (A[j - 1] >
         min))  // смещаем другие элементы к концу массива пока они меньше min
    {
      A[j] = A[j - 1];
      j--;  // смещаем просмотр к началу массива
      M++;
      C++;
    }
    A[j] = min;
    M += 2;
  }
  return (M + C);
}

int SelectSort(int *A, int n) {
  M = 0;
  C = 0;
  int min, t;
  for (int i = 0; i < n - 1; i++) {
    min = i;
    for (int j = i + 1; j < n; j++) {
      C++;
      if (A[j] < A[min]) min = j;
    }
    t = A[i];
    A[i] = A[min];
    A[min] = t;
    M += 3;
  }
  return (M + C);
}

int BubbleSort(int *A, int n) {
  M = 0;
  C = 0;
  int i, j, temp;
  for (i = 0; i < n - 1; i++) {
    for (j = n - 1; j > i; j--) {
      if (A[j - 1] > A[j]) {
        temp = A[j - 1];
        A[j - 1] = A[j];
        A[j] = temp;
        M += 3;
      }
      C++;
    }
  }
  return (C + M);
}

int ShakerSort(int *A, int n) {
  M = 0;
  C = 0;
  int i, j, temp, L = 0, R = n - 1, k = n - 1;
  do {
    for (i = R; i > L; i--) {
      if (A[i - 1] > A[i]) {
        temp = A[i - 1];
        A[i - 1] = A[i];
        A[i] = temp;
        k = i;
        M += 3;
      }
      C++;
    }
    L = k;
    for (j = L; j < R; j++) {
      if (A[j] > A[j + 1]) {
        temp = A[j + 1];
        A[j + 1] = A[j];
        A[j] = temp;
        k = j;
        M += 3;
      }
      C++;
    }
    R = k;
  } while (L < R);
  return (C + M);
}

int main()

{
  setlocale(LC_ALL, "Russian");
  int n = 500;
  int A[n], B[n];
  n = 10;
  int Is[n], Bs[n], Sls[n], Ss[n], Up[n], Dw[n];

  for (int i = 0; i < 5; i++) {
    n = (i + 1) * 100;
    FillRand(A, n);

    Sls[i] = SelectSort(A, n);
    FillRand(A, n);
    Is[i] = InsertSort(A, n);
    FillRand(A, n);
    Bs[i] = BubbleSort(A, n);
    FillRand(A, n);
    Ss[i] = ShakerSort(A, n);
    FillDec(A, n);
    Dw[i] = InsertSort(A, n);
    FillInc(A, n);
    Up[i] = InsertSort(A, n);
  }
  printf(
      " _____ ________________________ __________________________________\n");
  printf(
      "|  n  |  Select  |  Bubble  |  Shaker  |  Insert  |лучший|худший |\n");
  printf(
      "|_____|_____________________|_____________________|______|_______|\n");
  for (int i = 0; i < 5; i++) {
    printf("|  %d  |  %d   |  %d   |   %d  | %d    | %d    |   %d   |\n",
           (i + 1) * 100, Sls[i], Bs[i], Ss[i], Is[i], Up[i], Dw[i]);
    printf(
        "|________________________________________________________________|\n");
  }

  return 0;
}
