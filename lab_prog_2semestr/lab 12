#include "varioussorts.h"
#include <iostream>

int timer(int tip_sort(int[], int), int a[], int n) { return tip_sort(a, n); }
int timer(int tip_sort(float[], int), float a[], int n) {
  return tip_sort(a, n);
}

int main() {

  srand(time(NULL));
  int n = 1000;
  int mas1[n];
  fill_array(mas1, n);
  int bubblesort_time = timer(BubbleSort, mas1, n);
  fill_array(mas1, n);
  int shakersort_time = timer(ShakerSort, mas1, n);
  fill_array(mas1, n);
  int selectionsort_time = timer(SelectionSort, mas1, n);
  fill_array(mas1, n);
  int insertsort_time = timer(InsertSort, mas1, n);
  cout << "BubbleSort=" << bubblesort_time << endl;
  cout << "ShakerSort=" << shakersort_time << endl;
  cout << "SelectSort=" << selectionsort_time << endl;
  cout << "InsertSort=" << insertsort_time << endl;
  cout << endl;

  int mas2[n];
  fill_array(mas2, n);
  bubblesort_time = timer(BubbleSort, mas2, n);
  fill_array(mas2, n);
  shakersort_time = timer(ShakerSort, mas2, n);
  fill_array(mas2, n);
  selectionsort_time = timer(SelectionSort, mas2, n);
  fill_array(mas1, n);
  insertsort_time = timer(InsertSort, mas1, n);
  cout << "BubbleSort=" << bubblesort_time << endl;
  cout << "ShakerSort=" << shakersort_time << endl;
  cout << "SelectSort=" << selectionsort_time << endl;
  cout << "InsertSort=" << insertsort_time << endl;
}