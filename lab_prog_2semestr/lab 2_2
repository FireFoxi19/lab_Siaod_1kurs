#include <math.h>
#include <stdio.h>
/*
Дан массив ненулевых  целых чисел из N элементов. Используя рекурсию, напечатать
сначала все отрицательные, а потом - все положительные   числа этой
последовательности. Реализовать в одной функции, которая вызывается один раз.
*/

const int n = 10;
void Function(int* m, int i);
int main()

{
  int a[n] = {1, 2, -3, -1, -3, -2, 3, 4, 10, 12};
  Function(a, 0);
}

void Function(int* k, int i) {
  if (i < n) {
    if (k[i] < 0) {
      printf("%d ", k[i]);
    }
    Function(k, i + 1);
  }
  if (i >= n && i < n * 2) {
    if (k[i % n] > 0) {
      printf("%d ", k[i % n]);
    }
    Function(k, (i + 1));
  }
}