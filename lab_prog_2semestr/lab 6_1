#include <stdlib.h>
#include <cmath>
#include <iomanip>
#include <iostream>

using namespace std;
int A(float a, float b, float c, float *P, float *S)  // функция с указателями
{
  // расчет
  *P = (a + b + c);
  //*P= *P/2;
  *S = sqrt(*P / 2 * (*P / 2 - a) * (*P / 2 - b) * (*P / 2 - c));
  if (a < b + c && b < a + c && c < a + b)
    return 1;
  else
    cout << " ";
}

int main() {
  float a, b, c, P, S;
  cin >> a >> b >> c;
  if (A(a, b, c, &P, &S) == 1)
    ;  // &P и &S адреса переменных
  cout << fixed << setprecision(9) << P << ' '
       << S;  // установка точности с плавающей точкой
  return 0;
}