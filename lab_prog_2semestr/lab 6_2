#include <cmath>
#include <cstdlib>
#include <iomanip>
#include <iostream>

using namespace std;
int fact(int x) {
  int fac = 1;
  for (int i = 1; i <= x; ++i) fac *= i;
  return fac;
}

float r(int n, int m) {
  return fact(n) /
         (fact(m) * fact(n - m));  // вероятности передачи через ссылки
}

void A(int n, int m, float &p_boys,
       float &p_girls)  // передача адреса через & самостаоятельная переедача
                        // ссылки
{
  float p = 0.45, q = 1 - p;
  p_boys = r(n, m) * pow(q, m) * pow(p, n - m);
  p_girls = r(n, m) * pow(p, m) * pow(q, n - m);
}

int main() {
  int n, m;
  float p_boys, p_girls;
  cin >> n >> m;
  A(n, m, p_boys, p_girls);
  cout << fixed << setprecision(6) << p_boys << ' ' << p_girls;
  return 0;
}