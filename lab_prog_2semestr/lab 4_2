//Задан двумерный динамический массив А  размерности   m x n. ( m и n вводить с
//клавиатуры). Заполнить его случайными числами.  Создать массив D  размером m+1
//на  n+1, в который записать элементы массива А и суммы элементов
//соответствующих строк и столбцов исходного массива А. В элемент D[m+1][n+1]
//поместить сумму всех элементов исходного массива.

#include <stdlib.h>
#include <string.h>
#include <time.h>
#include <cmath>
#include <iostream>
using namespace std;

int main() {
  using namespace std;
  int rows, cols;
  cin >> rows >> cols;
  srand(time(NULL));
  int** b = (int**)(malloc(rows * sizeof(int*)));
  for (int i = 0; i < rows; i++) {
    b[i] = (int*)(malloc(cols * sizeof(int)));
  }
  for (int i = 0; i < rows; i++) {
    for (int j = 0; j < cols; j++) {
      b[i][j] = 2 + rand() % 20;
    }
  }
  for (int i = 0; i < rows; i++) {
    for (int j = 0; j < cols; j++) {
      cout.width(2);
      cout << b[i][j] << ' ';
    }
    cout << endl;
  }
  cout << endl;
  int** c = (int**)(malloc((rows + 1) * sizeof(int*)));
  for (int i = 0; i < rows + 1; i++) {
    c[i] = (int*)(malloc((cols + 1) * sizeof(int)));
  }
  for (int i = 0; i < rows; i++) {
    for (int j = 0; j < cols; j++) {
      c[i][j] = b[i][j];
    }
  }
  int sum = 0;
  for (int i = 0; i < rows; i++) {
    int sumj = 0;
    for (int j = 0; j < cols; j++) {
      sumj += b[i][j];
      sum += b[i][j];
    }
    c[i][cols] = sumj;
  }
  for (int i = 0; i < cols; i++) {
    int sumi = 0;
    for (int j = 0; j < rows; j++) {
      sumi += b[j][i];
    }
    c[rows][i] = sumi;
  }
  c[rows][cols] = sum;
  cout << endl;
  for (int i = 0; i < rows + 1; i++) {
    for (int j = 0; j < cols + 1; j++) {
      cout.width(2);
      cout << c[i][j] << ' ';
    }
    cout << endl;
  }
  delete[] b;
  delete[] c;
}